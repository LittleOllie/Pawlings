# =============================================================================
# The Adoption Project — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or live credentials to version control.
# =============================================================================

# --- PUBLIC (safe for browser) ---
# Your deployed site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# Supabase project URL (from Supabase dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (from Supabase dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Cloudflare Turnstile site key (public widget key)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- SERVER-ONLY (never expose to browser) ---

# Supabase service role key — FULL database access. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile secret key (for server-side verification)
TURNSTILE_SECRET_KEY=

# Application timezone for date display (storage is always UTC)
APP_TIMEZONE=UTC

# Optional: Admin seed credentials (development only)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
